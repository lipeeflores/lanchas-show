# ──────────────────────────────────────────────────────────────────
# Lanchas Show — environment variables
# Copy this file to .env and fill in the real values. Never commit .env.
# ──────────────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────────────
# URL of your Supabase project (e.g. https://abcd1234.supabase.co)
VITE_SUPABASE_URL=
# Public anon key (safe to expose in the frontend bundle)
VITE_SUPABASE_ANON_KEY=
# Server-only key. NEVER expose to the frontend.
SUPABASE_SERVICE_ROLE_KEY=

# ── Admin Panel Authentication ─────────────────────────────────────
# Credentials accepted by the backend POST /api/admin/login endpoint.
# Used while the platform is in private testing — replace before launch.
ADMIN_USERNAME=ADMIN
ADMIN_PASSWORD=ADMIN
# Random string used to sign admin session tokens (HMAC-SHA256).
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_SESSION_SECRET=

# ── Anthropic Claude (Isabelle) ────────────────────────────────────
ANTHROPIC_API_KEY=
# Optional override; defaults to claude-sonnet-4-6
CLAUDE_MODEL=claude-sonnet-4-6

# ── OpenAI Whisper (audio transcription) ───────────────────────────
OPENAI_API_KEY=

# ── Evolution API (WhatsApp gateway) ──────────────────────────────
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_NAME=lanchas_show
# Shared secret appended as ?token=… to the webhook URL configured in Evolution.
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
EVOLUTION_WEBHOOK_TOKEN=

# Postgres database that backs the Evolution container (docker-compose.yml).
EVOLUTION_DB_USER=evolution
EVOLUTION_DB_PASSWORD=
EVOLUTION_DB_NAME=evolution

# JID of the owners' WhatsApp group (ends with @g.us).
# To discover it: send a message in the group with Evolution connected and watch the logs.
OWNERS_GROUP_JID=

# ── Payments: Asaas ────────────────────────────────────────────────
# Token configured in the Asaas dashboard for outbound webhooks.
ASAAS_WEBHOOK_TOKEN=

# ── Contracts: DocuSeal ────────────────────────────────────────────
DOCUSEAL_API_KEY=
# HMAC secret configured in the DocuSeal dashboard for outbound webhooks.
DOCUSEAL_WEBHOOK_SECRET=

# ── Hosting / public URL of this backend ───────────────────────────
# Either BACKEND_URL (full URL, including https://) or RAILWAY_STATIC_URL (host only)
# must be set so Evolution can call back into this server.
BACKEND_URL=
# RAILWAY_STATIC_URL=

# Optional override for the Express port (default 3001)
# PORT=3001
